@startuml GoVid — Full Download Sequence

skinparam participantPadding 10
skinparam sequenceGroupBorderThickness 1
skinparam sequenceGroupFontSize 11
skinparam noteFontSize 11
skinparam shadowing false

actor       User            as U
participant "Fyne UI"       as UI
participant "DownloaderApp" as App
participant "UIManager"      as UIM
participant "LogService"     as LS
participant "DownloadEngine\nwatchOutput" as WO
participant "yt-dlp"        as YT
participant "FFmpeg"        as FF
participant "OS / Disk"     as OS

' ─────────────────────────────────────────────────────────────
' 1. APPLICATION STARTUP
' ─────────────────────────────────────────────────────────────
group Startup
    App -> App  : newDownloaderApp(window)\n  — chooseSettingsStore: settings.json beside the exe\n    with a GoVid.portable marker, else Fyne preferences\n  — init UIWidgets, load preferences
    App -> UIM  : dlApp.uiManager.createMainMenu()
    App -> UIM  : dlApp.uiManager.createUI()\n  — build layout, wire callbacks
    App -> UIM  : followSystemTheme(settings)\n  — re-apply the System theme when the OS switches light / dark
    App -> App  : reportSettingsLocation()  — log where settings are kept (portable or not)
    App -> OS   : removeOldTools()  — delete the .old copies a tool update left behind
    App -> UIM  : dlApp.uiManager.checkDependencies()
    UIM -> OS   : DependencyService.Check()\n  — Stat(yt-dlp), Stat(ffmpeg)
    OS  --> UIM : found / missing
    alt dependency missing
        UIM -> App : onLog warning for missing tool
    end
    App -> App  : go checkTools()\n  — notice with Install for a missing yt-dlp or FFmpeg\n  — depSvc.JSRuntime(): bin/deno, then deno / node / bun on PATH\n    (none → notice offering to install Deno)
    opt "Check for updates on startup" enabled
        App -> App  : go checkYtDlpUpdate()\n  — depSvc.Version("yt-dlp") vs releaseSvc.Latest(yt-dlp/yt-dlp)\n    (GitHub asked at most once a day; 403 = unknown)
        alt installed yt-dlp is older
            App -> UIM : showNotice("yt-dlp X is out of date", "Update now" → runUpdateInUI)
        end
        App -> App  : checkGoVidUpdate()\n  — skipped for a "dev" build\n  — main.version vs releaseSvc.Latest(DunderGG/govid)
        alt newer GoVid release
            App -> UIM : showNotice("GoVid X is available", "What's new" → showGoVidRelease)
        end
    end
    App -> App  : go startGPUDetection()\n  — gpuSvc.Detect(ctx) runs in the background,\n    populating the GPUBackend → BackendCapability cache once
    opt offerQueueRestore: queue.json holds downloads saved when GoVid last quit
        App -> UI  : askRestoreQueue("Resume N downloads?")
        UI  --> App : Resume → resumeQueue (a restored session, no URL check)\n  / Discard → RemovePartialFiles for each
    end
    UI  -> U    : ShowAndRun() — window visible
end

' ─────────────────────────────────────────────────────────────
' 2. USER INITIATES DOWNLOAD
' ─────────────────────────────────────────────────────────────
U   -> UI  : enter URL(s), path, format, quality\n  optional: trim times, speed limit, cookies
U   -> UI  : click "Download Now!"
UI  -> App : startDownload()

group Input Validation
    App -> App : collect URLs (single / batch-mode split)
    App -> App : validateTimestamp(trimStart, trimEnd)
    alt validation fails
        App -> UI : dialog.ShowError(...)
        App --> U : [abort]
    end
end

group Session Initialisation
    App -> App  : savePreferences(savePath)
    App -> UI   : reset log, progress bar, status → "Initializing…"
    App -> UI   : setStatusIndicator("active")
    App -> App  : sessionFailed.Store(false)
    App -> LS   : EndStartup()\n  — later lines written without a log file are not buffered
    alt saveLog.Checked
        App -> LS : OpenSessionLog(savePath)\n  — open timestamped session log
        LS  --> App : log path
        LS  -> LS : flush preSession lines (at most 500)\n  — startup diagnostics buffered before the first session
        App -> LS : WriteSessionConfig(cfg, appendOutput)
    end
    App -> App  : context.WithCancel(Background)\n  → queueCtx / stopQueue
end

' ─────────────────────────────────────────────────────────────
' 3. PROGRESS SMOOTHER GOROUTINE
' ─────────────────────────────────────────────────────────────
App -> App : go progressSmoother(queueCtx)\n  — time.NewTicker(33 ms)\n  — step = (targetPct - current) × 0.05\n  — minimum step 0.001; frames changing the bar by < 0.002 skipped\n  — stops on queueCtx.Done()

' ─────────────────────────────────────────────────────────────
' 4. BATCH DOWNLOAD LOOP (goroutine)
' ─────────────────────────────────────────────────────────────
App -> App : go batchWorker(queueCtx)
App -> App : buildPostProcessFilters()\n  → vfFilters, afFilters

group checkURLs(queueCtx, session) [for each URL entered]
    App -> UI  : updateStatus("Checking URL…")
    App -> YT  : engine.Probe(ctx, req)\n  — yt-dlp -J --flat-playlist -f <selector> (no --no-playlist)
    YT  --> App : MediaInfo{Type, Title, Entries}
    alt playlist
        App -> UI  : askPlaylist(ctx, prompt)\n  — title, video count, total length, range field\n  — Download / Only this video / Cancel
        U   -> UI  : choose range (e.g. 5-8)
        UI  --> App : playlistDecision{positions}
        App -> App : each chosen entry's URL → its own queueItem
    else single video
        App -> App : queueItem{url, info (with its raw JSON)}
    else probe failed
        App -> App : queueItem{url, probeFailed}
    end
end

group loop [while QueueModel.Next() returns a waiting item]
    note right : the Queue panel may remove, move, retry, pause, or resume\nitems while the loop runs. With Simultaneous Downloads 2–3,\nrunParallel runs this loop in that many workers (3 s apart),\neach item with its own Skip / Pause and a "[n/total]" log prefix.\nOnly paused items left → waitForResume (the button reads Resume).
    alt batch mode (len > 1)
        App -> App : context.WithCancel(queueCtx)\n  → runCtx / skipItem  (per-URL cancel)
        note right : Cancel skips only the active URL;\nqueueCtx and later URLs remain available.
    else single URL
        note right : runCtx == queueCtx; Cancel stops the whole session.
    end
    opt checkItem: no fresh probe answer (playlist entry, or older than 30 min)
        App -> YT  : engine.ProbeVideo(runCtx, req)\n  — yt-dlp -J --flat-playlist --no-playlist -f <selector>
        YT  --> App : MediaInfo (raw JSON, size, title)
    end
    opt live or scheduled stream (MediaInfo.LiveStatus)
        App -> UI  : askLive: Record from now / from the start / Skip,\n  or Wait and record (--wait-for-video 60-300) / Skip
        note right : a recording skips the disk check below;\nrecordingCallback checks free space every 30 s
    end
    App -> OS  : freeBytes(save folder)
    alt probe size × 1.1 (× 2 with post-processing) > free space
        App -> UI  : askDiskSpace("Needs ~X, Y free. Continue anyway?")\n  — single: Continue anyway / Cancel\n  — batch: Skip / Continue / Stop
        UI  --> App : spaceProceed / spaceSkip / spaceStop / spaceContinueAll
    else size unknown
        App -> UI  : appendOutput("Download size unknown; skipping the disk space check.")
    end

    App -> App : downloadContext(runCtx): Pause → errPaused,\n  Stop recording → errStopKeep, quitting → errPaused
    App -> App : runYtDlp(downloadCtx, session, item.downloadRequest(){InfoJSON, DownloadID, FormatPick}, …)\n  — yt-dlp --continue, -f pick or selector, --js-runtimes, cookies

    group engine.Run(ctx, req, opts, cb)  — BuildArgs + Execute + FinalizeFiles / RemovePartialFiles
        App -> OS  : saveInfoJSON → temp govid-*.info.json (removed when Run returns)
        group Build yt-dlp arguments
            App -> App : select format flag (bestvideo+bestaudio / audio-only / WebM VP9…)
            App -> App : apply quality height filter if set
            App -> App : embed unique downloadID token in output template
            App -> App : append ""--ffmpeg-location"", ""--limit-rate"", ""--cookies"" if set
            App -> App : append ""--download-sections"" / ""--force-keyframes-at-cuts"" if trimming
            App -> App : append ""--merge-output-format"", ""--remux-video"", ""--recode-video""
            App -> App : append ""--load-info-json <file>"" instead of the URL when InfoJSON is set
        end

        group Retry loop [attempt 1..3]
            App -> OS  : newToolCommand(runCtx, yt-dlp, args…)
  — cmd.Cancel kills the whole process tree
            OS  -> YT  : spawn process
            App -> YT  : StdoutPipe() + StderrPipe()
            App -> YT  : cmd.Start()
            App -> UI  : updateStatus("Downloading…")

            App -> WO  : engine.watchOutput(stdout, stderr, cb)

            group Concurrent output scanning
                WO  -> YT : scan stdout line by line
                loop stdout lines
                    WO  -> WO  : engine.parseProgress(line, cb)\n  — extract %
                    WO  -> WO  : detect [download] Destination:\n  — collect source extension
                    WO  -> App : cb.OnProgress(pct)\n  — App applies to stats.targetPct
                    WO  -> WO  : detect [Merger]/[VideoConvertor] → wasConverted
                    WO  -> App : cb.OnPhase("Merging"/"Converting")\n  — App snaps the bar to 95%, status "Merging…"
                    WO  -> App : cb.OnLog(line, foreground colour)
                end
                WO  -> WO : scanner.Err() check → log if I/O error

                WO  -> YT : scan stderr line by line
                loop stderr lines
                    WO  -> WO  : same [Merger]/[VideoConvertor]/[ExtractAudio] checks as stdout
                    WO  -> WO  : check transientErrPatterns\n  — 429, timeout, connection/reset errors → hadTransientErr
                    WO  -> App : cb.OnLog(line, red/amber/grey/default)
                end
                WO  -> WO : scanner.Err() check → log if I/O error
            end

            WO  --> App : scanResult{sourceExts, wasConverted, hadTransientErr}
            App -> YT  : cmd.Wait()
            YT  --> App : exit code / error (cmdErr)

            alt cmdErr == nil
                App -> App : break retry loop  ✓
            else cmdErr != nil && autoRetry.Checked && hadTransientErr && attempt < 3
                App -> UI  : appendOutput("[SYSTEM] Transient error — retrying in Xs…")
                App -> App : time.After(1s / 5s / 30s)  [or ctx.Done()]
                note right : attempts: 1 s → 5 s → 30 s backoff
            else permanent failure or auto-retry disabled
                App -> App : break retry loop  ✗
            end
        end

        alt cmdErr == nil, or stopped with errStopKeep (a kept recording)
            App -> OS  : engine.FinalizeFiles(savePath, downloadID)\n  — filesWithID(*downloadID*), skipping .part / .ytdl\n  — strip token, uniquePath (under renameMu)\n  — renameWithRetry(tmp → final); still locked → keeps tmp\n  — a kept recording: finishRecording remuxes it
            OS  --> App : []finalPaths
            App -> OS  : engine.RemoveLeftoverPartials(savePath, downloadID)\n  — only .part / .ytdl / .temp files
        else paused (errPaused)
            App -> App : keep the partial files → DownloadResult.Paused
        else failed or cancelled
            App -> OS  : engine.RemovePartialFiles(savePath, downloadID)\n  — filesWithID(*downloadID*) → os.Remove (retried while locked)
        end
        opt the loaded info failed with HTTP 403 / 410 (hadExpiredLinkErr)
            App -> UI  : appendOutput("download links were refused (expired?); asking the site for new ones")
            App -> YT  : run once more from the URL (BuildArgs without --load-info-json)
        end
    end
    App <-- App : DownloadResult{FinalPaths, Extension, Scan, Err, Bytes, ResumedBytes}\n  — Bytes measured on disk, for the summary

    group UI result (fyne.Do)
        alt cancelled (ctx.Err == Canceled)
            App -> UI : appendOutput("DOWNLOAD ABORTED", stats summary)
            App -> UI : setStatusIndicator("canceled")
        else cmdErr != nil (failure)
            App -> UI : appendOutput("DOWNLOAD FAILED")
            App -> UI : setStatusIndicator("failed")
            App -> App : sessionFailed.Store(true)
            alt notify.Checked
                App -> OS : SendNotification("Download Failed")
            end
        else success
            App -> UI : appendOutput("DOWNLOAD COMPLETE", duration/speed/format)
            App -> UI : setProgressNow(1.0)
            App -> UI : setStatusIndicator("success")
        end
    end

    alt batch mode
        App -> App : skipItem()  — release per-URL context
    end
end
App -> App : finishQueue(queue)\n  — quitting: saveQueue → queue.json (waiting + paused)\n  — else: waiting → Skipped, paused → RemovePartialFiles

' ─────────────────────────────────────────────────────────────
' 5. POST-PROCESSING (optional)
' ─────────────────────────────────────────────────────────────
alt hasPostProcess && len(allFinalPaths) > 0 && not cancelled
    App -> UI  : updateStatus("Post-processing…")
    App -> UI  : setStatusIndicator("processing")
    App -> App : applyFFmpegFilters(queueCtx, allFinalPaths, vfFilters, afFilters, gpuBackend)

    group Worker pool [numWorkers = min(NumCPU, numJobs)]
        loop for each PostProcessJob (concurrent)
            App -> App  : resolveAutoCrop()\n  — if __autocrop__ sentinel present:
            App -> FF   : cropdetect pass (first 60 s)
            FF  --> App : crop=W:H:X:Y  (or "" if no bars)
            App -> App  : PlanEncoder(engine.GPUBackend,\n  engine.GPUCapabilities, containerExt)\n  — resolves GPU -c:v args, or CPU\n    (libx264 CRF 18 / libvpx-vp9 CRF 31) if unavailable
            App -> App  : engine.buildFFmpegArgsForBackend(input, tmpOutput,\n  vfFilters, afFilters, backend, threadsPerJob)
            App -> App  : guard := newGPUJobGuard(engine, job.usedGPU)\n  — blocks until a gpuSem slot is free (max 2 concurrent GPU jobs)
            App -> OS   : exec FFmpeg process
            OS  -> FF   : spawn process
            App -> App  : guard.arm(onStall)  — no-op for CPU jobs

            loop FFmpeg stderr progress lines
                FF  -> App : frame=N fps=X speed=Y
                App -> App : guard.pet()  — resets the stall watchdog
                App -> UI  : updateStatus(progress %)
            end

            FF  --> App : exit code
            alt FFmpeg failure && ctx canceled
                App -> App : cancelJob(job, cb)\n  — no OnFailure, no CPU retry
                App -> OS  : os.Remove(tmpOutput)  [clean up partial]
                App -> UI  : appendOutput("[SYSTEM] Post-processing canceled: <file>", orange)
            else FFmpeg success
                App -> OS  : os.Rename(tmpOutput → finalPath)
                App -> OS  : os.Remove(inputPath)  [original replaced]
            else FFmpeg failure && job.usedGPU
                App -> App : guard.release()
                App -> App : engine.retryWithCPU(ctx, job, cb, reason)\n  — rebuilds args with BackendOff, re-runs runJob()
            else FFmpeg failure (CPU job)
                App -> App : sessionFailed.Store(true)
                App -> OS  : os.Remove(tmpOutput)  [clean up partial]
                App -> UI  : appendOutput("[SYSTEM] FFmpeg failed…", red)
            else GPU stall watchdog fires
                App -> App : guard callback kills FFmpeg process\n  — 30 s with no stderr output
                App -> App : guard.release()\n  — retryWithCPU if GPU job, otherwise record failure
            end
            App -> App : guard.release()  — deferred; idempotent no-op if already released
        end
    end

    alt all jobs done, not cancelled
        App -> UI : updateStatus("Done.")
        App -> UI : setStatusIndicator("success")
        alt notify.Checked
            App -> OS : SendNotification("All Done — N file(s) processed")
        end
    else cancelled
        App -> UI : updateStatus("Canceled.")
        App -> UI : setStatusIndicator("canceled")
    end

else no post-processing
    alt notify.Checked && success
        App -> OS : SendNotification("Download Complete")
    end
end

' ─────────────────────────────────────────────────────────────
' 6. SESSION TEARDOWN
' ─────────────────────────────────────────────────────────────
group Teardown
    App -> LS  : CloseSessionLog()
    App -> App : stopQueue()  — cancels queueCtx → stops progress smoother
    App -> App : <-smootherDone  — waits for its last write
    App -> App : clear cancel / stop funcs, isRunning = false
    alt sessionFailed
        App -> UI : downloadBtn.SetText("Retry")
    end
    App -> UI  : downloadBtn.Enable()
    App -> UI  : cancelBtn.Disable()
end

@enduml
